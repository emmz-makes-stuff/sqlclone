<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SqlClone/SqlClone.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/*.sql" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Scripts/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
